#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    chosen {
        // zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zephyr,display = &ssd1306;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        status = "disabled";
        diode-direction = "col2row";
        wakeup-source;

        // col2row: 列(col)側が出力、行(row)側が入力（プルダウン必要）
        // ※実機PCBのダイオード向き(QMK側 diode_direction: COL2ROW)に合わせています
        // ★実際の配線に合わせて確定
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        // col0は元々xiao_d5だったが、OLED用I2C(D4=SDA, D5=SCL)を確保するためxiao_d2に変更
        col-gpios
            = <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            , <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            ;
    };

    // row0はcol1, col2にのみスイッチがあり、col0, col3は未使用のため、マップから除外しています。
    // (5行 x 4列 = 20マス中、18マスのみキーが存在／QMK側info.jsonのlayoutsと一致させています)
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <5>;

        map = <
        //                      Backspace   NumLock
                                 RC(0,1)     RC(0,2)
        //   7         8         9           /
             RC(1,0)   RC(1,1)   RC(1,2)     RC(1,3)
        //   4         5         6           *
             RC(2,0)   RC(2,1)   RC(2,2)     RC(2,3)
        //   1         2         3           -
             RC(3,0)   RC(3,1)   RC(3,2)     RC(3,3)
        //   0         .         Enter       +
             RC(4,0)   RC(4,1)   RC(4,2)     RC(4,3)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };
};

// 拡張ボードのOLED(0.96インチ SSD1306, I2C接続, D4=SDA/D5=SCL)
&i2c0_default {
    group1 {
        bias-pull-up;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>; // 100kHzに落として安定性を確認

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0xf1>;
    };
};
